# Copy to .env for local use. On Vercel add the same names under Project > Settings > Environment Variables.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=firecracker
# Passwords for the two accounts, used only when the users collection is empty (first run)
ADMIN_PASSWORD=
STAFF_PASSWORD=
